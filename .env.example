# Environment variables for nsecbunkerd (Docker Compose).
# For Docker, DATABASE_URL is set as a constant in docker-compose.yml (file:/app/config/nsecbunker.db)
# and does NOT belong here. Only override it if you run nsecbunkerd directly on the host:
#
#   DATABASE_URL="file:$HOME/.nsecbunker-config/nsecbunker.db"

# Admin npub(s), comma-separated. The identity allowed to manage this bunker.
# ADMIN_NPUBS=npub1q2s369...

# Name of the encrypted signing key in nsecbunker.json.
# Must match the name used by `make setup` / the `add` command. Passphrase comes from signer-identity.txt.
NSECBUNKER_KEY_NAME=bitspark@local
