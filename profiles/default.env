# Profile: default
#
# This file is a Make fragment (included by the Makefile), so use $(HOME) and
# `?=` so values can still be overridden on the CLI, e.g.:
#   make up PROFILE=default HOST_PORT=4000
#
# It contains NO secrets (only paths, ports, names) and is safe to commit.
# Secrets live in the file named by SIGNER_IDENTITY_FILE (gitignored).

CONFIG_DIR           ?= $(HOME)/.nsecbunker-config
PROJECT              ?= nsecbunker
HOST_PORT            ?= 3009
KEY_NAME             ?= bitspark@local
# Bunker NDK relays (same URL works for bunker and browser on a public relay).
RELAY                ?= wss://nos.lol
# Optional client-facing overrides (leave empty to reuse RELAY / http://localhost:HOST_PORT).
CLIENT_RELAY         ?=
PUBLIC_BASE_URL      ?=
RELAY_SMOKE_URL      ?= $(RELAY)
SIGNER_IDENTITY_FILE ?= signer-identity.txt
LOCAL_RELAY          ?= 0
RELAY_HOST_PORT      ?= 7777
ADMIN_NPUBS          ?=
