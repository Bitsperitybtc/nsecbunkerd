# Profile: local (isolated dev/test stack)
#
# DEV_HOST = IP/hostname of the machine where Docker runs — used in connection.txt
# and approval URLs so your browser (anywhere on the LAN) can reach relay + bunker.
# Override: make patch-config PROFILE=local DEV_HOST=192.168.1.50

CONFIG_DIR           ?= $(HOME)/.nsecbunker-config-local
PROJECT              ?= nsecbunker-local
HOST_PORT            ?= 3019
KEY_NAME             ?= bitspark@local
DEV_HOST             ?= 172.29.105.70
RELAY                ?= ws://relay:8080
CLIENT_RELAY         ?= ws://$(DEV_HOST):7777
PUBLIC_BASE_URL      ?= http://$(DEV_HOST):3019
RELAY_SMOKE_URL      ?= ws://relay:8080
SIGNER_IDENTITY_FILE ?= signer-identity-local.txt
LOCAL_RELAY          ?= 1
RELAY_HOST_PORT      ?= 7777
ADMIN_NPUBS          ?=
